# PflegeRust Server & MariaDB Konfiguration
# Kopieren Sie diese Datei bei lokaler Entwicklung nach .env und tragen Sie Ihre Werte ein.
# Im Debian .deb Paket und im Docker-Container werden diese Werte automatisch generiert.

PORT=3000
HOST=0.0.0.0

# MariaDB Verbindungsdaten (nur serverseitig, niemals mit VITE_ praefixen)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pflege_db
DB_USER=pfleged
DB_PASSWORD=
DB_SSL=false

# Im Produktivbetrieb (Debian .deb / Docker) immer false setzen
ALLOW_MEMORY_FALLBACK=false
